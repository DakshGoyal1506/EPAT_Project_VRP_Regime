# ============================================================
# EPAT VRP Regime Project Environment Template
# Copy this file to .env and fill values locally.
# Do not commit .env.
# ============================================================

# ----------------------------
# General
# ----------------------------
PROJECT_ENV=local
LOG_LEVEL=INFO

# ----------------------------
# Data directories
# ----------------------------
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
BROKER_CACHE_DIR=data/broker_cache

# ----------------------------
# Public data source placeholders
# ----------------------------

# Optional. FRED VIXCLS can often be accessed without a key through pandas-datareader,
# but keep this placeholder for future API-based access.
FRED_API_KEY=

# Optional. Yahoo Finance through yfinance usually does not require a key.
YAHOO_FINANCE_ENABLED=true

# Optional. NSE may require headers/cookies depending on access method.
NSE_USER_AGENT=Mozilla/5.0
NSE_REFERER=https://www.nseindia.com/

# Optional. CBOE historical CSV endpoint placeholder.
CBOE_VIX_URL=

# Optional future extension. Not required for Phase 0.
POLYGON_API_KEY=

# ----------------------------
# IBKR / iBridgePy paper-signal placeholders
# ----------------------------

# Broker layer is paper/signal-only by default.
IBKR_PAPER_SIGNAL_ONLY=true
IBKR_LIVE_TRADING_ENABLED=false

# TWS / Gateway paper connection placeholders.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=101

# Optional account placeholder. Do not commit real account identifiers.
IBKR_ACCOUNT_ID=
IBKR_PAPER_ACCOUNT=

# ----------------------------
# Safety flags
# ----------------------------

ALLOW_LIVE_ORDERS=false
REQUIRE_MANUAL_BROKER_CONFIRMATION=true
